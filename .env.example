# Firebase API Keys
FIREBASE_API_KEY_ANDROID=set-variable-here
FIREBASE_API_KEY_IOS=set-variable-here
FIREBASE_APP_ID_ANDROID=set-variable-here
FIREBASE_APP_ID_IOS=set-variable-here

# Firebase Project info
FIREBASE_PROJECT_ID=set-variable-here
FIREBASE_MESSAGING_SENDER_ID=set-variable-here
FIREBASE_STORAGE_BUCKET=set-variable-here

# API (example below is for Android emulator and runing .NET API on its default port 5058)
API_BASE_URL=http://10.0.2.2:5058

# Local service mode to run the app, can be the following:
# - API  --> Uses the API_BASE_URL to connect to the backend API (local or production)
# - MOCK --> Uses mock data to checkout the app in offine mode (as a DEMO without tracking feature)
LOCAL_SERVICE=API

# Google Maps API key
GOOGLE_MAPS_API_KEY_ANDROID=set-variable-here
